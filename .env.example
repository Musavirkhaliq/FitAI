# --- Database (any Postgres: Supabase, Neon, local). Use the pooled URL for DATABASE_URL on serverless. ---
DATABASE_URL="postgresql://user:password@host:5432/fittrack?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/fittrack?schema=public"

# --- Auth.js ---  generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_TRUST_HOST=true
# Google OAuth (obtain from Google Cloud Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Email Delivery (Supabase or SMTP) ---
# Supabase Auth Email (obtain from Project Settings > API):
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Alternatively, standard SMTP:
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
# Use an address on a domain you control and have verified with your email provider.
EMAIL_FROM="SukoonFit <noreply@example.com>"
# If both are omitted, verification links are printed to the server console in development mode.

# --- LLM (OpenAI-compatible). Primary = Groq. Swap provider by changing base URL + key + model. ---
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_API_KEY=""
LLM_MODEL="llama-3.3-70b-versatile"
# Small, fast model for intent classification and JSON extraction (the "analysis" model).
LLM_EXTRACT_MODEL="llama-3.1-8b-instant"
# Fallback = Gemini OpenAI-compatible endpoint (optional)
LLM_FALLBACK_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
LLM_FALLBACK_API_KEY=""
LLM_FALLBACK_MODEL="gemini-2.5-flash"

# --- Speech-to-text. Providers: groq (default) | local | deepgram | assemblyai. Configured fallbacks are tried in turn. ---
# With NO key at all, the mic still works in Chrome/Edge via the browser's built-in speech recognition.
STT_PROVIDER="groq"
STT_BASE_URL="https://api.groq.com/openai/v1"
STT_API_KEY=""                 # Groq reuses LLM_API_KEY if this is empty
STT_MODEL="whisper-large-v3-turbo"
DEEPGRAM_API_KEY=""            # optional fallback ($200 one-time credit)
ASSEMBLYAI_API_KEY=""          # optional fallback ($50 one-time credit, pre-recorded audio)
# Self-hosted Whisper (privacy / offline): run any OpenAI-compatible server (faster-whisper-server, whisper.cpp server),
# then set STT_PROVIDER="local", STT_BASE_URL="http://localhost:8000/v1" and STT_MODEL to the model it serves.

# --- Text-to-speech. Providers: google | elevenlabs | browser (empty/unset keys fall back to the browser voice) ---
TTS_PROVIDER="google"
GOOGLE_TTS_API_KEY=""
GOOGLE_TTS_VOICE="en-US-Neural2-F"
# Set a GCP budget alert before enabling: free tier is 1M chars/mo for Neural2, 4M for Standard/WaveNet.
# ElevenLabs (most natural voices). Free-plan audio has NO commercial rights and needs attribution: prototyping only.
# To use it set TTS_PROVIDER="elevenlabs" and a key:
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
ELEVENLABS_MODEL="eleven_flash_v2_5"

# --- Food databases ---
USDA_API_KEY="DEMO_KEY"
